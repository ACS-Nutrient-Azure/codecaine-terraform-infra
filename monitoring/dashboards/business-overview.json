{
  "title": "Business Overview",
  "description": "에이전트 사용 현황, 토큰 소비, Tool 실행, 캐시 효율 - 비즈니스 지표 통합 대시보드",
  "tags": ["bedrock", "agentcore", "redis", "cdci"],
  "timezone": "Asia/Seoul",
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "서비스",
        "type": "custom",
        "current": { "text": "All", "value": "%" },
        "options": [
          { "text": "All",              "value": "%",                "selected": true },
          { "text": "analysis-agent",   "value": "analysis-agent",   "selected": false },
          { "text": "chatbot-agent",    "value": "chatbot-agent",    "selected": false },
          { "text": "supervisor-agent", "value": "supervisor-agent", "selected": false },
          { "text": "summary-agent",    "value": "summary-agent",    "selected": false },
          { "text": "question-agent",   "value": "question-agent",   "selected": false }
        ],
        "query": "%,analysis-agent,chatbot-agent,supervisor-agent,summary-agent,question-agent",
        "hide": 0,
        "refresh": 0,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [

    {
      "id": 100,
      "title": "에이전트 호출 현황",
      "type": "row",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },

    {
      "id": 1,
      "title": "에이전트별 총 호출 수 (24h)",
      "type": "bargauge",
      "gridPos": { "x": 0, "y": 1, "w": 8, "h": 6 },
      "datasource": { "type": "cloudwatch", "uid": "bfh249rbispvkf" },
      "description": "custom metric: CDCI/AgentCore > agent_invocation_total (dimension: agent_name)",
      "targets": [
        {
          "refId": "A",
          "queryMode": "Metrics", "metricQueryType": 1, "metricEditorMode": 1,
          "region": "default",
          "sqlExpression": "SELECT SUM(agent_invocation_total) FROM \"CDCI/AgentCore\" GROUP BY agent_name"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["sum"] }, "orientation": "horizontal", "displayMode": "gradient", "valueMode": "color" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } } }
    },

    {
      "id": 2,
      "title": "에이전트별 에러 횟수 (24h)",
      "type": "bargauge",
      "gridPos": { "x": 8, "y": 1, "w": 8, "h": 6 },
