      "description": "custom metric: CDCI/AgentCore > agent_invocation_total WHERE status=error GROUP BY agent_name",
      "targets": [
        {
          "refId": "A",
          "queryMode": "Metrics", "metricQueryType": 1, "metricEditorMode": 1,
          "region": "default",
          "sqlExpression": "SELECT SUM(agent_invocation_total) FROM \"CDCI/AgentCore\" WHERE \"status\" = 'error' GROUP BY agent_name"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["sum"] }, "orientation": "horizontal", "displayMode": "gradient" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 20 }] } } }
    },

    {
      "id": 3,
      "title": "에이전트 호출 추이 (시간대별)",
