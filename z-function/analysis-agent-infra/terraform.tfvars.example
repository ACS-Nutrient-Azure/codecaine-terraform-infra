# ── AWS ──────────────────────────────────────────────────────────
aws_region     = "ap-northeast-2"
aws_account_id = " "

# ── 프로젝트 ─────────────────────────────────────────────────────
project_name = "analysis-agent"
environment  = "dev"

# ── GitHub ───────────────────────────────────────────────────────
github_org  = "ACS-Nutrients"
github_repo = " "

# ── Lambda ───────────────────────────────────────────────────────
lambda_timeout     = 30
lambda_memory_size = 256
lambda_runtime     = "python3.12"

# ── AgentCore Runtime ─────────────────────────────────────────────
agentcore_idle_timeout  = 300
agentcore_max_lifetime  = 1800
agentcore_network_mode  = "PUBLIC"

# ── ECR ──────────────────────────────────────────────────────────
ecr_image_count_limit = 10
